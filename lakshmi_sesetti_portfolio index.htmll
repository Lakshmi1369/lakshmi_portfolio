<script>
  // Generate a kolam-style dot grid with a self-drawing connecting line in the hero
  (function(){
    const svg = document.getElementById('kolamSvg');
    const ns = 'http://www.w3.org/2000/svg';
    const cols = 12, rows = 6, spacing = 74, offsetX = 40, offsetY = 30;
    const dots = [];
    for(let r=0;r<rows;r++){
      for(let c=0;c<cols;c++){
        const x = offsetX + c*spacing;
        const y = offsetY + r*spacing;
        dots.push([x,y]);
        const circle = document.createElementNS(ns,'circle');
        circle.setAttribute('cx',x);
        circle.setAttribute('cy',y);
        circle.setAttribute('r',1.6);
        circle.setAttribute('fill','rgba(246,241,231,0.25)');
        svg.appendChild(circle);
      }
    }
    // build a wandering path through a subset of dots, kolam-style loops
    const colors = ['#F2A93B','#E0527F','#2BB3AA'];
    const pathCount = 3;
    for(let p=0;p<pathCount;p++){
      const startCol = p*4;
      let d = '';
      let px, py;
      for(let i=0;i<7;i++){
        const c = (startCol + i*1.6) % cols;
        const r = (Math.sin(i*1.3+p) * 2 + 2.6);
        const x = offsetX + c*spacing;
        const y = offsetY + Math.max(0,Math.min(rows-1,r))*spacing;
        if(i===0){ d += 'M '+x+' '+y; px=x; py=y; }
        else {
          const mx = (px+x)/2 + (i%2===0?18:-18);
          const my = (py+y)/2;
          d += ' Q '+mx+' '+my+' '+x+' '+y;
          px=x; py=y;
        }
      }
      const path = document.createElementNS(ns,'path');
      path.setAttribute('d',d);
      path.setAttribute('fill','none');
      path.setAttribute('stroke',colors[p]);
      path.setAttribute('stroke-width','1.6');
      path.setAttribute('stroke-linecap','round');
      path.setAttribute('opacity','0.55');
      svg.appendChild(path);
      const len = path.getTotalLength();
      path.style.strokeDasharray = len;
      path.style.strokeDashoffset = len;
      path.animate(
        [{strokeDashoffset:len},{strokeDashoffset:0}],
        {duration:1800+p*300, delay:p*250, fill:'forwards', easing:'ease-in-out'}
      );
    }
  })();
</script>

</body>
</html>
