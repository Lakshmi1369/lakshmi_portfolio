<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Sesetti Venkata Lakshmi — Portfolio</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&family=Space+Grotesk:wght@400;500;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
  :root{
    --ink:#1E2A3A;
    --ink-deep:#141D29;
    --paper:#F6F1E7;
    --paper-dim:#A9B4C2;
    --marigold:#F2A93B;
    --gulal:#E0527F;
    --turquoise:#2BB3AA;
    --line:rgba(246,241,231,0.14);
  }
  *{box-sizing:border-box;margin:0;padding:0;}
  html{scroll-behavior:smooth;}
  body{
    background:var(--ink);
    color:var(--paper);
    font-family:'Space Grotesk',sans-serif;
    line-height:1.6;
    overflow-x:hidden;
  }
  ::selection{background:var(--marigold);color:var(--ink-deep);}

  .wrap{max-width:880px;margin:0 auto;padding:0 32px;}

  /* ---------- NAV ---------- */
  nav{
    position:sticky;top:0;z-index:50;
    background:rgba(30,42,58,0.88);
    backdrop-filter:blur(6px);
    border-bottom:1px solid var(--line);
  }
  nav .wrap{display:flex;justify-content:space-between;align-items:center;height:64px;}
  .nav-mark{font-family:'Fraunces',serif;font-weight:600;font-size:19px;letter-spacing:0.02em;}
  .nav-links{display:flex;gap:28px;list-style:none;}
  .nav-links a{color:var(--paper-dim);text-decoration:none;font-size:14px;letter-spacing:0.03em;transition:color .2s;}
  .nav-links a:hover{color:var(--marigold);}

  /* ---------- HERO ---------- */
  .hero{position:relative;padding:96px 0 80px;overflow:hidden;}
  .hero-grid{position:absolute;inset:0;z-index:0;opacity:0.9;}
  .hero-inner{position:relative;z-index:1;display:grid;grid-template-columns:1fr auto;gap:48px;align-items:center;}
  @media (max-width:680px){.hero-inner{grid-template-columns:1fr;}}
  .hero-photo{
    width:200px;height:200px;border-radius:50%;overflow:hidden;
    border:2px solid var(--marigold);justify-self:end;
    box-shadow:0 0 0 6px rgba(30,42,58,0.6), 0 0 0 7px var(--line);
  }
  .hero-photo img{width:100%;height:100%;object-fit:cover;object-position:center 18%;display:block;}
  @media (max-width:680px){.hero-photo{justify-self:start;width:150px;height:150px;}}
  .eyebrow{
    font-family:'JetBrains Mono',monospace;font-size:13px;color:var(--turquoise);
    letter-spacing:0.08em;text-transform:uppercase;margin-bottom:18px;display:block;
  }
  h1.display{
    font-family:'Fraunces',serif;font-weight:600;font-size:clamp(38px,6vw,64px);
    line-height:1.05;letter-spacing:-0.01em;max-width:720px;
  }
  .hero-role{
    font-size:19px;color:var(--paper-dim);margin-top:20px;max-width:560px;
  }
  .hero-cta{display:flex;gap:14px;margin-top:36px;flex-wrap:wrap;}
  .btn{
    font-family:'Space Grotesk',sans-serif;font-weight:500;font-size:14px;
    padding:12px 22px;border-radius:2px;text-decoration:none;
    border:1px solid var(--paper);color:var(--paper);
    transition:all .2s;
  }
  .btn:hover{background:var(--paper);color:var(--ink-deep);}
  .btn.filled{background:var(--marigold);border-color:var(--marigold);color:var(--ink-deep);}
  .btn.filled:hover{background:var(--turquoise);border-color:var(--turquoise);color:var(--ink-deep);}

  /* ---------- SECTION SHELL ---------- */
  section{padding:64px 0;border-top:1px solid var(--line);position:relative;}
  .sec-label{
    font-family:'JetBrains Mono',monospace;font-size:12px;color:var(--paper-dim);
    letter-spacing:0.1em;text-transform:uppercase;margin-bottom:10px;
  }
  h2.title{
    font-family:'Fraunces',serif;font-weight:500;font-size:clamp(26px,3.4vw,34px);
    margin-bottom:36px;
  }
  p.lede{color:var(--paper-dim);font-size:16px;max-width:640px;}

  /* ---------- EDUCATION (dot-grid timeline) ---------- */
  .kolam-line{list-style:none;position:relative;padding-left:28px;}
  .kolam-line::before{
    content:"";position:absolute;left:5px;top:6px;bottom:6px;width:1px;
    background:repeating-linear-gradient(to bottom, var(--paper-dim) 0 3px, transparent 3px 9px);
  }
  .kolam-line li{position:relative;margin-bottom:32px;}
  .kolam-line li::before{
    content:"";position:absolute;left:-28px;top:4px;width:9px;height:9px;border-radius:50%;
    background:var(--ink);border:1.5px solid var(--marigold);
  }
  .edu-degree{font-family:'Fraunces',serif;font-size:19px;font-weight:500;}
  .edu-meta{font-size:14px;color:var(--paper-dim);margin-top:4px;}
  .edu-meta span{color:var(--turquoise);}

  /* ---------- SKILLS ---------- */
  .skill-block{margin-bottom:28px;}
  .skill-block h3{
    font-family:'JetBrains Mono',monospace;font-size:13px;color:var(--paper-dim);
    text-transform:uppercase;letter-spacing:0.08em;margin-bottom:14px;font-weight:400;
  }
  .chips{display:flex;flex-wrap:wrap;gap:10px;}
  .chip{
    font-family:'JetBrains Mono',monospace;font-size:13px;padding:7px 14px;
    border:1px solid var(--line);border-radius:2px;color:var(--paper);
  }
  .chip.tech{border-color:rgba(43,179,170,0.5);color:var(--turquoise);}
  .chip.soft{border-color:rgba(224,82,127,0.5);color:var(--gulal);}

  /* ---------- EXPERIENCE / CERTS ---------- */
  .entry{
    display:grid;grid-template-columns:1fr auto;gap:8px 24px;align-items:start;
    padding:18px 0;border-bottom:1px solid var(--line);
  }
  .entry:last-child{border-bottom:none;}
  .entry-title{font-family:'Fraunces',serif;font-size:17px;font-weight:500;}
  .entry-org{font-size:14px;color:var(--paper-dim);margin-top:3px;}
  .entry-link{
    font-family:'JetBrains Mono',monospace;font-size:12px;color:var(--marigold);
    text-decoration:none;white-space:nowrap;align-self:center;border:1px solid rgba(242,169,59,0.4);
    padding:5px 10px;border-radius:2px;transition:all .2s;
  }
  .entry-link:hover{background:var(--marigold);color:var(--ink-deep);}

  /* ---------- LANG / INTERESTS ---------- */
  .split-two{display:grid;grid-template-columns:1fr 1fr;gap:48px;}
  @media (max-width:640px){.split-two{grid-template-columns:1fr;gap:32px;}}
  .plain-list{list-style:none;}
  .plain-list li{
    font-size:15px;padding:9px 0;border-bottom:1px solid var(--line);
    display:flex;justify-content:space-between;
  }
  .plain-list li:last-child{border-bottom:none;}
  .plain-list .idx{font-family:'JetBrains Mono',monospace;color:var(--turquoise);font-size:12px;}

  /* ---------- CONTACT / FOOTER ---------- */
  footer{padding:72px 0 56px;text-align:center;}
  footer .title{margin-bottom:14px;}
  footer p.lede{margin:0 auto 32px;}
  .contact-row{display:flex;gap:14px;justify-content:center;flex-wrap:wrap;}
  .foot-note{
    margin-top:56px;font-size:12px;color:var(--paper-dim);
    font-family:'JetBrains Mono',monospace;
  }
</style>
</head>
